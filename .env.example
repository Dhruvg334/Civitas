# Shared
CIVITAS_ENV=development
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
CIVITAS_INTERNAL_API_KEY=
# Backend's own DB connection. Used directly by FastAPI ops layer.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Geospatial package reads this. Points at the same DB as DATABASE_URL.
CIVITAS_POSTGIS_DSN=postgresql://postgres:postgres@localhost:5432/postgres

# AI / ML
GROQ_API_KEY=
CIVITAS_LLM_PRIMARY_MODEL=
CIVITAS_LLM_FAST_MODEL=
CIVITAS_LLM_TIMEOUT_SECONDS=20
CIVITAS_LLM_MAX_RETRIES=2
CIVITAS_LLM_TEMPERATURE=0
CIVITAS_LLM_STRICT_JSON_SCHEMA=false
EMBEDDING_MODEL=
ML_SERVICE_URL=http://localhost:8001

# Service-to-service policy retrieval
CIVITAS_BACKEND_BASE_URL=http://localhost:8000
CIVITAS_BACKEND_API_TOKEN=
CIVITAS_BACKEND_TIMEOUT_SECONDS=10
CIVITAS_WORKFLOW_HTTP_TIMEOUT_SECONDS=10
CIVITAS_WORKFLOW_HTTP_MAX_RETRIES=2
# Required by the production workflow checkpoint saver.
CIVITAS_WORKFLOW_CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Optional observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Civitas

# Optional external demo-media mirror for locally contributed files
CIVITAS_DEMO_MEDIA_BASE_URL=
