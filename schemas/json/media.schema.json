{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Media Reference",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "media_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "image",
        "video"
      ]
    },
    "mime_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "local_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
