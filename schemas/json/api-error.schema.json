{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Civitas API Error Envelope",
  "type": "object",
  "required": [
    "success",
    "error",
    "trace_id",
    "timestamp"
  ],
  "properties": {
    "success": {
      "const": false
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "trace_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
