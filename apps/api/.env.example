# Shared
CIVITAS_ENV=development
LOG_LEVEL=INFO

# Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional for legacy HS256 Supabase projects; modern projects use SUPABASE_URL JWKS.
SUPABASE_JWT_SECRET=

# Database
DATABASE_URL=postgresql://user:password@host:port/postgres
CIVITAS_POSTGIS_DSN=

# Storage (used by LocalDisk fallback)
STORAGE_BUCKET=report-media
CIVITAS_STORAGE_ROOT=./storage
# Required in production for internal ML/media endpoints
CIVITAS_INTERNAL_API_KEY=
# Agent runtime / checkpointing
CIVITAS_WORKFLOW_CHECKPOINT_DATABASE_URL=postgresql://user:password@host:port/postgres
GROQ_API_KEY=
CIVITAS_LLM_PRIMARY_MODEL=openai/gpt-oss-120b
CIVITAS_LLM_FAST_MODEL=openai/gpt-oss-20b
LANGGRAPH_STRICT_MSGPACK=true
